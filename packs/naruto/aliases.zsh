# Naruto — shared git & dev shortcuts
alias rasengan='git push'
alias kage-bunshin='git checkout -b'      # shadow clone = new branch
alias summon='git pull'
alias byakugan='git status -sb'
alias sharingan='git log --oneline --graph --decorate --all'
alias chidori='git commit -m'
alias substitution='git stash'
alias kai='git stash pop'
alias edo-tensei='git reflog'             # bring back "lost" commits
alias ninja-run='npm run dev'
alias ramen='npm install'
alias hokage='sudo'
